# Server-only. Copy to .env; never commit it or use VITE_ for secrets.
AI_API_KEY=
AI_MODEL=gpt-5-mini
AI_MAX_OUTPUT_TOKENS=2500
# Illustrative estimates in USD per million tokens; check current provider pricing.
AI_INPUT_USD_PER_MILLION=0.25
AI_CACHED_INPUT_USD_PER_MILLION=0.025
AI_OUTPUT_USD_PER_MILLION=2.00
HOST=127.0.0.1
PORT=4173

# Production AI: server-only, both modes DEFAULT OFF. See FRIENDS_BETA.md.
# Numeric values here are examples, never a verified current pricing feed.
AI_BETA_ENABLED=false
AI_BYOK_ENABLED=false
AI_BETA_PRICING_CONFIRMED=false
AI_BETA_ORIGIN=https://reading-aid.vercel.app
AI_BETA_BUDGET_USD=5
# SHA-256 of the dedicated owner code. Old AI_BETA_INVITES_JSON is ignored.
AI_OWNER_CODE_SHA256=
AI_BETA_SESSION_SECRET=
AI_BETA_REDIS_REST_URL=
AI_BETA_REDIS_REST_TOKEN=
